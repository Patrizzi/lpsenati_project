# Logs
*.log
/storage/logs/*
!/storage/logs/.gitignore

# Environment & local settings
.env
.env.backup
.env.production
.env.*.local

# Databases & local stores
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
/database/*.sqlite
/database/*.sqlite-journal
/database/*.sqlite-wal
/database/*.sqlite-shm

# Caches & temporary test artifacts
.phpunit.result.cache
/.phpunit.cache
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore

# Storage app private/public generated files
/storage/app/private/*
!/storage/app/private/.gitignore
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/*.key
/storage/pail

# Composer & NPM dependencies
/vendor
/node_modules
/auth.json

# Build outputs & dev server artifacts
/public/build
/public/hot
/public/storage

# Local temporary test/automation scripts
/capture-*.cjs
/recapture.cjs

# Impeccable review captures and internal caches (preserve docs/contracts)
/.impeccable/mocks
/.impeccable/review
/.impeccable/config.local.json

# IDEs & System files
.DS_Store
Thumbs.db
.phpactor.json
/.fleet
/.idea
/.nova
/.vscode
/.zed
Homestead.json
Homestead.yaml

.vercel
.env*
